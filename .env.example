# ===============================
# DATABASE CONFIGURATION
# ===============================
DATABASE_URL="mysql://mediadocks_user:change-me@127.0.0.1:3306/mediadocks"

DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="mediadocks_user"
DB_PASSWORD="change-me"
DB_NAME="mediadocks"

# ─── App ─────────────────────────────────────────────────────────────────────
# SEO-critical. Canonical links, OpenGraph URLs, sitemap.xml entries and all
# JSON-LD ids are built from this. Set it to the public https domain before
# deploying, or the live site will declare localhost as its canonical home and
# will not index properly. The build prints a warning if this is still localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Leave empty to call the API on the same origin.
NEXT_PUBLIC_API_URL=

# ─── Resolver mode ───────────────────────────────────────────────────────────
# true  -> no external platform request is made, demo results are returned
# false -> real platform resolvers are used
# The browser always calls POST /api/resolve either way.
MOCK_RESOLVER=false

# ─── Debugging ───────────────────────────────────────────────────────────────
# Prints the resolver trace to the server console. Ignored in production.
DEBUG_RESOLVER=false

# ─── Temporary data ──────────────────────────────────────────────────────────
MEDIA_TTL_MINUTES=30
STORAGE_PATH=./storage/tmp
MAX_FILE_SIZE_MB=500
MAX_URL_LENGTH=2048
REQUEST_TIMEOUT_MS=15000

# ─── Rate limiting (in-memory, optional) ─────────────────────────────────────
RESOLVE_LIMIT=10
RESOLVE_WINDOW_SECONDS=60
DOWNLOAD_LIMIT=5
DOWNLOAD_WINDOW_SECONDS=60
TRANSCRIBE_LIMIT=3
TRANSCRIBE_WINDOW_SECONDS=60

# ─── AI transcription ────────────────────────────────────────────────────────
# Required by /video-to-text. Set the key in .env only; never expose it through
# NEXT_PUBLIC_* variables or commit a real value to this example file.
# Gemini's lower-cost/free-tier model is retried with this same key when the
# primary model is unavailable. Free-tier availability and quotas are controlled
# by the Google AI project associated with the key.
GEMINI_API_KEY=
GEMINI_TRANSCRIPTION_MODEL=gemini-3.8-flash
# Used by the audio summarizer. Falls back to the same model list as above.
GEMINI_SUMMARY_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
TRANSCRIBE_MAX_FILE_SIZE_MB=100
TRANSCRIBE_MAX_DURATION_SECONDS=7200
TRANSCRIBE_TIMEOUT_MS=180000

# ─── Extraction engine (yt-dlp + FFmpeg) ─────────────────────────────────────
# Primary extractor for every platform. Enables YouTube downloads and
# selectable video resolutions / audio formats. Requires yt-dlp; FFmpeg is
# needed for muxed resolutions and MP3. Both are installed in the Docker image.
ENGINE_ENABLED=true
# Path to a yt-dlp binary; empty falls back to `<PYTHON_PATH> -m yt_dlp`.
YTDLP_PATH=
PYTHON_PATH=python
# FFmpeg / ffprobe binaries. Empty = discover automatically (PATH, then the
# well-known install locations: winget/scoop/choco on Windows, /usr/bin,
# /usr/local/bin and /opt/homebrew/bin on Linux and macOS).
FFMPEG_PATH=
FFPROBE_PATH=
# Metadata probe ceiling (fast) and the separate download+mux ceiling, which
# must allow minutes for a large file transfer plus remux.
ENGINE_TIMEOUT_MS=90000
ENGINE_DOWNLOAD_TIMEOUT_MS=600000
MAX_MEDIA_DURATION_SECONDS=3600
# Verify tooling at any time: curl http://localhost:3000/api/health

# ─── Usage measurement (anonymous, aggregate) ────────────────────────────────
# Powers the /superadmin report. No IP addresses are stored and the URLs people
# paste are never recorded — only which platform they belonged to. Visitors are
# counted with a daily-rotating salted digest that cannot be reversed or linked
# across days. Set false to record nothing at all.
ANALYTICS_ENABLED=true
# Makes visitor digests unguessable and keeps unique-visitor counts stable across
# restarts. Use a long random string, e.g. `openssl rand -hex 32`.
ANALYTICS_SALT=
# Events older than this are deleted by the opportunistic cleanup routine.
ANALYTICS_RETENTION_DAYS=90

# ─── Super admin (/superadmin) ───────────────────────────────────────────────
# Credentials may be stored in the database, in this environment, or both.
# Either source may grant access; one source never masks a valid password in the
# other. Diagnose configuration with `npm run admin:check`, or test a password
# interactively with `npm run admin:test-password`.
#
# Create or reset a database credential with:
#   npm run admin:create -- --generate    strong random password, written to a
#                                         gitignored file; only a hash is stored
#   npm run admin:create                  prompts for your own password
SUPER_ADMIN_EMAIL=
# Preferred environment credential: a scrypt digest from `npm run admin:hash`.
# If this and SUPER_ADMIN_PASS are both set, the hash takes precedence.
SUPER_ADMIN_PASS_HASH=
# Plaintext environment credential. Convenient for development, but anything
# that can read this file gains admin access. Prefer the hash in production.
SUPER_ADMIN_PASS=
# Signs the admin session cookie. Generate with `openssl rand -hex 32`.
# Without it a random per-process secret is used, which logs you out on restart.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=8
